// interrupt
void HAL_GPIO_EXTI_Callback(uint16_t GPIO_PIN) {
	if(GPIO_PIN == GPIO_PIN_4) {
		uint32_t last_interrupt_time = 0;
		uint32_t current_time = HAL_GetTick();
		if(current_time - last_interrupt_time >= debounce_delay) {
			if(counter < 9) {
				counter++;
			}
			else {
				counter = 0;
			}
			BaseType_t xHigherPriorityTaskWoken = pdFALSE;
			xEventGroupSetBitsFromISR(button_pressed, BUTTON_BIT ,&xHigherPriorityTaskWoken);
			portYIELD_FROM_ISR(xHigherPriorityTaskWoken);
		}
	}
}

void CalcSwitch1(void *pvParameters)
{
  for(;;)
  {
	EventBits_t CalcSwitch;
	uint32_t Calc_counter = 0;
	CalcSwitch = xEventGroupWaitBits(button_pressed, BUTTON_BIT, pdTRUE, pdFALSE, 2);
	if((CalcSwitch & BUTTON_BIT) != 0) {
		Calc_counter = counter*10;
		UARTqueue Calc_UART = {DATA_COUNTER, Calc_counter};
		xQueueSend(UARTdataHandle, &Calc_UART, queue_delay);
	}

  }
}

void IncreaseVar(void *pvParameters)
{
	TickType_t xLastWakeTime;
	const TickType_t xFrequency = 10;
	xLastWakeTime = xTaskGetTickCount();
  for(;;)
  {
	if(xSemaphoreTake(sharedHandle, mutex_delay) == pdTRUE) {
		if(shared < 200) {
			shared++;
		}
		else {
			shared = 100;
		}
		UARTqueue Increase_UART = {DATA_SHARED, shared};
		xSemaphoreGive(sharedHandle);
		xQueueSend(UARTdataHandle, &Increase_UART, queue_delay);
	}
	xTaskDelayUntil(&xLastWakeTime, xFrequency);
  }
}

void DecreaseVar(void *pvParameters)
{
	TickType_t xLastWakeTime;
		const TickType_t xFrequency = 12;
		xLastWakeTime = xTaskGetTickCount();
  for(;;)
  {
	  if(xSemaphoreTake(sharedHandle, mutex_delay) == pdTRUE) {
	  		if(shared > 100) {
	  			shared--;
	  		}
	  		else {
	  			shared = 200;
	  		}
	  		UARTqueue Decrease_UART = {DATA_SHARED, shared};
	  		xSemaphoreGive(sharedHandle);
	  		xQueueSend(UARTdataHandle, &Decrease_UART, queue_delay);
	  }
	  xTaskDelayUntil(&xLastWakeTime, xFrequency);
  }
}

void UART(void *pvParameters)
{
	TickType_t xLastWakeTime;
	const TickType_t xFrequency = 5;
	xLastWakeTime = xTaskGetTickCount();
  for(;;)
  {
	  UARTqueue received_message;
	  while(xQueueReceive(UARTdataHandle, &received_message, 0) == pdPASS) {
		  if(received_message.source == DATA_COUNTER) {
			  snprintf(UART_buffer, sizeof(UART_buffer), "Source: counter, Value = %lu\r\n", received_message.data);
		  }
		  else if (received_message.source == DATA_SHARED) {
			  snprintf(UART_buffer, sizeof(UART_buffer), "Source: shared, Value = %lu\r\n", received_message.data);
		  }
		  else {
			  snprintf(UART_buffer, sizeof(UART_buffer), "Source: UNKNOWN\r\n");
		  }
		  HAL_UART_Transmit(&huart1, (uint8_t*)UART_buffer, strlen(UART_buffer), 100);
	  }
	  xTaskDelayUntil(&xLastWakeTime, xFrequency);
  }
}

